  @@index([type])
  @@index([createdAt])
  @@index([clientId], map: "wehoware_inventory_items_client_id_fkey")
  @@index([createdBy], map: "wehoware_inventory_items_created_by_fkey")
  @@index([updatedBy], map: "wehoware_inventory_items_updated_by_fkey")
  @@map("wehoware_inventory_items")
}

model WehowareInventoryStockMovement {
  id              String                 @id @default(uuid()) @db.VarChar(36)
  itemId          String                 @map("item_id") @db.VarChar(36)
  clientId        String                 @map("client_id") @db.VarChar(36)
  movementType    String                 @map("movement_type") @db.VarChar(50)
  quantityChange  Int                    @map("quantity_change")
  quantityAfter   Int                    @map("quantity_after")
  reason          String?                @db.Text
  createdBy       String?                @map("created_by") @db.VarChar(36)
  createdAt       DateTime               @default(now()) @map("created_at")
  item            WehowareInventoryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  client          WehowareClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator         WehowareProfile?       @relation(fields: [createdBy], references: [id])

  @@index([itemId])
  @@index([clientId])
  @@index([movementType])
  @@index([createdAt])
  @@map("wehoware_inventory_stock_movements")
}

model WehowareInventorySetting {
  id                    String           @id @default(uuid()) @db.VarChar(36)
  clientId              String           @unique @map("client_id") @db.VarChar(36)
  defaultCurrency       String           @default("CAD") @map("default_currency") @db.VarChar(10)
  lowStockThreshold     Int              @default(5) @map("low_stock_threshold")
  autoArchiveDays       Int              @default(90) @map("auto_archive_days")
  enableStockTracking   Boolean          @default(true) @map("enable_stock_tracking")
  enableLowStockAlerts  Boolean          @default(true) @map("enable_low_stock_alerts")
  enablePublicListing   Boolean          @default(true) @map("enable_public_listing")
  enableInquiries       Boolean          @default(true) @map("enable_inquiries")
  enableTestDrive       Boolean          @default(false) @map("enable_test_drive")
  defaultItemType       String           @default("product") @map("default_item_type") @db.VarChar(50)
  listingPageTitle      String?          @map("listing_page_title") @db.VarChar(255)
  listingPageDescription String?         @map("listing_page_description") @db.Text
  contactEmail          String?          @map("contact_email") @db.VarChar(255)
  contactPhone          String?          @map("contact_phone") @db.VarChar(50)
  businessHours         String?          @map("business_hours") @db.VarChar(255)
  address               String?          @db.Text
  socialFacebook        String?          @map("social_facebook") @db.VarChar(500)
  socialInstagram       String?          @map("social_instagram") @db.VarChar(500)
  socialTwitter         String?          @map("social_twitter") @db.VarChar(500)
  socialYoutube         String?          @map("social_youtube") @db.VarChar(500)
  seoTitle              String?          @map("seo_title") @db.VarChar(255)
  seoDescription        String?          @map("seo_description") @db.VarChar(500)
  seoKeywords           String?          @map("seo_keywords") @db.VarChar(500)
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  client                WehowareClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId], map: "wehoware_inventory_settings_client_id_fkey")
  @@map("wehoware_inventory_settings")
}

model WehowareDailyWorkReportItem {
  id           String   @id @default(uuid()) @db.VarChar(36)
  reportId     String   @map("report_id") @db.VarChar(36)
  taskId       String   @map("task_id") @db.VarChar(36)
  subtaskId    String?  @map("subtask_id") @db.VarChar(36)
  startTime    DateTime @map("start_time")
  endTime      DateTime @map("end_time")
  hoursWorked  Decimal  @map("hours_worked") @db.Decimal(5, 2)
  description  String?  @db.Text
  sequence     Int      @default(0) @map("sequence")
  createdAt    DateTime @default(now()) @map("created_at")

  report       WehowareDailyWorkReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  task         WehowareTask @relation(fields: [taskId], references: [id])
  subtask      WehowareSubtask? @relation(fields: [subtaskId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([taskId])
  @@map("wehoware_daily_work_report_items")
}
