# ================================================================
# Wehoware SaaS — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# ================================================================

# ----------------------------------------------------------------
# DATABASE (MySQL 8.0+)
# ----------------------------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://wehoware_user:your_password@localhost:3306/wehoware_saas"

# ----------------------------------------------------------------
# NEXTAUTH (Auth.js v5)
# ----------------------------------------------------------------
# Required: random 32+ char secret for JWT signing.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-char-minimum-random-secret-here"

# Full URL of your app (no trailing slash).
# In production, set to your actual domain.
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------------------------------
# SUPABASE (transitional — required until all 62 files are migrated)
# Auth system has been replaced by NextAuth + MySQL/Prisma.
# These keys are still used by non-auth API routes during migration.
# Remove once Phase 4 (full codebase refactor) is complete.
# ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ----------------------------------------------------------------
# APP CONFIG
# ----------------------------------------------------------------
# Default client ID for public-facing pages (contact forms, etc.)
NEXT_PUBLIC_CLIENT_ID="your-default-client-uuid"

# ----------------------------------------------------------------
# AWS S3 (Phase 3 — Storage migration, not yet implemented)
# Uncomment and fill in when completing the storage migration.
# ----------------------------------------------------------------
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-secret-access-key"
# AWS_S3_BUCKET_NAME="wehoware-assets"
# AWS_S3_CDN_URL="https://your-cdn.cloudfront.net"
