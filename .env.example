# ================================================================
# Wehoware SaaS — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# ================================================================

# ----------------------------------------------------------------
# DATABASE (MySQL 8.0+ / Aurora Serverless)
# ----------------------------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Local dev:  mysql://wehoware:wehoware_pass_2024@localhost:3306/wehoware
# Production: mysql://admin:Wehoware2025@theatre-aurora-uat-instance-1.clkekw2aslew.ca-central-1.rds.amazonaws.com:3306/wehoware
DATABASE_URL="mysql://admin:Wehoware2025@theatre-aurora-uat-instance-1.clkekw2aslew.ca-central-1.rds.amazonaws.com:3306/wehoware"

# ----------------------------------------------------------------
# NEXTAUTH (Auth.js v5)
# ----------------------------------------------------------------
# Required: random 32+ char secret for JWT signing.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="W3ufwzuk9ag2xk58nH7d8RV4BwYF36rI7tSiVOlOan4="
# Set to your production URL when deployed (Amplify, Vercel, etc.)
# Local:     http://localhost:3000
# Amplify:   https://<your-app>.amplifyapp.com
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------------------------------
# APP CONFIG
# ----------------------------------------------------------------
# Default client ID for public-facing pages (contact forms, etc.)
NEXT_PUBLIC_CLIENT_ID="b728b2c3-e795-485b-8693-32912d2acab4"
# Public URL — set to your deployed domain
# Local:     http://localhost:3000
# Amplify:   https://<your-app>.amplifyapp.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Encryption key for sensitive data (Plaid tokens, OAuth tokens, etc.)
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY="nVlubgUthgD98X0IRv87iMbYSA660MBIz9vjzzLnXLw="
# Public URL — set to your deployed domain
# Local:     http://localhost:3000
# Amplify:   https://<your-app>.amplifyapp.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Encryption key for sensitive data (Plaid tokens, OAuth tokens, etc.)
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY="nVlubgUthgD98X0IRv87iMbYSA660MBIz9vjzzLnXLw="

# ----------------------------------------------------------------
# AWS S3 (File uploads, static assets)
# ----------------------------------------------------------------
AWS_REGION="ca-central-1"
AWS_ACCESS_KEY_ID="AKIAXYKJROLX3JSEC6KU"
AWS_SECRET_ACCESS_KEY="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"
S3_BUCKET_NAME="wehoware-saas-storage"
S3_CDN_URL="https://wehoware-saas-storage.s3.ca-central-1.amazonaws.com"

# ----------------------------------------------------------------
# PLAID (Bank feeds, transaction sync)
# ----------------------------------------------------------------
PLAID_CLIENT_ID=69edb4a5a2fb5d000ef6dcad
PLAID_SECRET=b0df5fa6b7eeb3b3ef594275c7a7b8
PLAID_ENV=sandbox   # or development / production
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US,CA
PLAID_WEBHOOK_URL=https://app.wehoware.com/api/v1/plaid/webhook

# ----------------------------------------------------------------
# GOOGLE OAUTH (Calendar API)
# ----------------------------------------------------------------
# 1. Create project at https://console.cloud.google.com/
# 2. Enable Google Calendar API
# 3. APIs & Services → Credentials → Create OAuth client ID (Web)
# 4. Add redirect URI: https://app.wehoware.com/api/v1/integrations/google/calendar/callback
# 5. Paste Client ID and Secret below
GOOGLE_CLIENT_ID=914095060149-7d8tc0lera2ppq0a2ijakngdtptk2hop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=https://app.wehoware.com/api/v1/integrations/google/calendar/callback

# ----------------------------------------------------------------
# MICROSOFT OAUTH (Graph API / Outlook Calendar)
# ----------------------------------------------------------------
# 1. Go to https://portal.azure.com/ → App registrations → New registration
# 2. Name: Wehoware Outlook Calendar
# 3. Supported account types: Accounts in any org + personal accounts
# 4. Add redirect URI (Web): https://app.wehoware.com/api/v1/integrations/microsoft/calendar/callback
# 5. API permissions → Microsoft Graph → Delegated: Calendars.ReadWrite, offline_access
# 6. Certificates & secrets → New client secret → copy value immediately
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://app.wehoware.com/api/v1/integrations/microsoft/calendar/callback

# ----------------------------------------------------------------
# ZOOM OAUTH (Video Meetings)
# ----------------------------------------------------------------
# 1. Go to https://marketplace.zoom.us/ → Develop → Build App → OAuth
# 2. App type: OAuth → User-managed app
# 3. OAuth Information → Add redirect URI: https://app.wehoware.com/api/v1/integrations/zoom/callback
# 4. Scopes: meeting:write, user:read
# 5. Copy Client ID and Client Secret below
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://app.wehoware.com/api/v1/integrations/zoom/callback

# ----------------------------------------------------------------
# SOCIAL MEDIA — Facebook & Instagram (Meta Graph API v18.0)
# ----------------------------------------------------------------
# 1. Go to https://developers.facebook.com/ → My Apps → Create App
# 2. Product: "Facebook Login" + "Instagram Graph API"
# 3. App Review → request: pages_manage_posts, pages_read_engagement,
#    instagram_basic, instagram_content_publish, pages_show_list
# 4. Settings → Basic → App ID and App Secret
FACEBOOK_APP_ID=4402515559994389
FACEBOOK_APP_SECRET=6ead2e34d6585d3a7b46b1ac565dcc89
FACEBOOK_CALLBACK_URL=https://app.wehoware.com/api/v1/social/platforms/facebook/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CALLBACK_URL=https://app.wehoware.com/api/v1/social/platforms/instagram/callback

# ----------------------------------------------------------------
# SOCIAL MEDIA — Twitter / X (API v2 + OAuth 2.0 PKCE)
# ----------------------------------------------------------------
# 1. Go to https://developer.twitter.com/ → Projects → Create App
# 2. Authentication settings → OAuth 2.0 → Enable
# 3. App permissions: Read and Write
# 4. Callback URL: https://app.wehoware.com/api/v1/social/platforms/twitter/callback
# 5. API Key = Client ID, API Secret = Client Secret
TWITTER_API_KEY="<your-twitter-api-key>"
TWITTER_API_SECRET="<your-twitter-api-secret>"
TWITTER_CALLBACK_URL=https://app.wehoware.com/api/v1/social/platforms/twitter/callback

# ----------------------------------------------------------------
# SOCIAL MEDIA — TikTok (TikTok for Developers)
# ----------------------------------------------------------------
# 1. Go to https://developers.tiktok.com/ → Manage Apps → Create App
# 2. Capabilities: Login Kit + Content Posting API
# 3. Redirect URI: https://app.wehoware.com/api/v1/social/platforms/tiktok/callback
# 4. Client Key and Client Secret from app dashboard
TIKTOK_CLIENT_KEY="<your-tiktok-client-key>"
TIKTOK_CLIENT_SECRET="<your-tiktok-client-secret>"
TIKTOK_CALLBACK_URL=https://app.wehoware.com/api/v1/social/platforms/tiktok/callback

# ----------------------------------------------------------------
# CRON JOB SECURITY
# ----------------------------------------------------------------
# Set a random secret to protect the cron endpoint.
# Include as header: x-cron-secret: <value>
# Generate with: openssl rand -base64 32
CRON_SECRET=
CRON_AUTH_MODE=hmac

# ----------------------------------------------------------------
# EMAIL (AWS SES)
# ----------------------------------------------------------------
EMAIL_PROVIDER_MODE=ses
EMAIL_FROM_ADDRESS=noreply@wehoware.com

# ----------------------------------------------------------------
# LLM PROVIDERS (SEO Analyser)
# ----------------------------------------------------------------
# OpenRouter API key — get one at https://openrouter.ai/keys
# Free models: Llama 3.3 70B, Kimi K2.6, and more
OPENROUTER_API_KEY="<your-openrouter-api-key>"

# LLM provider configuration
SEO_LLM_PROVIDER_MODE=auto
SEO_LLM_MANUAL_PROVIDER=openrouter
SEO_LLM_AUTO_FAILOVER=true
SEO_LLM_TIMEOUT_MS=120000
SEO_LLM_CIRCUIT_BREAKER_THRESHOLD=5
SEO_LLM_CIRCUIT_BREAKER_COOLDOWN_MS=30000

# System-wide default LLM models (used when client DB override is NULL)
OPENROUTER_DEFAULT_ANALYSIS_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_DEFAULT_SUGGESTION_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

# Wehoware Private AI (OpenAI-compatible server via Cloudflare Tunnel)
WEHOWARE_AI_API_KEY="<your-wehoware-ai-key>"
WEHOWARE_DEFAULT_ANALYSIS_MODEL=qwen2.5:3b
WEHOWARE_DEFAULT_SUGGESTION_MODEL=qwen2.5:3b

# --- SEO Analyser Thresholds ---
SEO_ANALYSER_DUPLICATE_SIMILARITY_THRESHOLD=0.85
SEO_ANALYSER_NEAR_DUPLICATE_THRESHOLD=0.70
SEO_ANALYSER_FRESHNESS_STALE_MONTHS=6
SEO_ANALYSER_TFIDF_LOW_THRESHOLD=0.01

# --- Database Seeding (optional overrides) ---
SEED_ADMIN_EMAIL=admin@wehoware.com
SEED_ADMIN_PASSWORD="<your-admin-password>"

# ================================================================
# AI BRAIN CONNECTION (Baddy AI CEO)
# ================================================================
# The AI Brain runs on a local server (RTX 3090) and is exposed
# via Cloudflare Tunnel. No Tailscale/VPN needed — just HTTPS.
#
# Cloudflare Tunnel routes (add in CF Zero Trust dashboard):
#   ai.wehoware.ca     → localhost:18020 (vLLM)
#   memory.wehoware.ca → localhost:9097  (Mem0)
#
# Protect with Cloudflare Access (IP restrict to your Amplify IP).
# ----------------------------------------------------------------

# --- Baddy AI Assistant (vLLM via Cloudflare Tunnel) ---
# Local dev (running on AI Brain server):   http://localhost:18020/v1
# Production (SaaS on AWS/Amplify):         https://ai.wehoware.ca/v1
VLLM_BASE_URL="https://ai.wehoware.ca/v1"
VLLM_API_KEY="wehoware-vllm-2026"
VLLM_MODEL="qwen3.8-27b"

# --- Mem0 Memory Bridge (persistent conversation memory via Cloudflare Tunnel) ---
# Local dev (running on AI Brain server):   http://localhost:9097
# Production (SaaS on AWS/Amplify):         https://memory.wehoware.ca
MEM0_BRIDGE_URL="https://memory.wehoware.ca"

# ----------------------------------------------------------------
# PUBLIC URL & EMAIL (Invoice Sharing / PDF)
# ----------------------------------------------------------------
# Set to your production domain when deployed
NEXT_PUBLIC_APP_URL="https://app.wehoware.com"
EMAIL_FROM_ADDRESS="noreply@wehoware.com"