  @@index([clientId])
  @@index([status])
  @@index([invoiceDate])
  @@map("wehoware_invoices")
}

// =============================================================
// 30. Invoice Line Items
// =============================================================
model WehowareInvoiceLineItem {
  id          String   @id @default(uuid()) @db.VarChar(36)
  invoiceId   String   @map("invoice_id") @db.VarChar(36)
  clientId    String   @map("client_id") @db.VarChar(36)
  description String   @db.VarChar(500)
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  invoice WehowareInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  client  WehowareClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("wehoware_invoice_line_items")
}

// =============================================================
// 31. Transactions
// =============================================================
model WehowareTransaction {
  id              String            @id @default(uuid()) @db.VarChar(36)
  clientId        String            @map("client_id") @db.VarChar(36)
  transactionDate DateTime          @map("transaction_date") @db.Date
  description     String            @db.VarChar(500)
  amount          Decimal           @db.Decimal(12, 2)
  type            TransactionType   @default(Other)
  status          TransactionStatus @default(Pending)
  reference       String?           @db.VarChar(255)
  currency        String            @default("CAD") @db.VarChar(10)
  notes           String?           @db.Text
  invoiceId       String?           @map("invoice_id") @db.VarChar(36)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  createdBy       String?           @map("created_by") @db.VarChar(36)

  client  WehowareClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator WehowareProfile? @relation("TransactionCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([status])
  @@index([transactionDate])
  @@map("wehoware_transactions")
}
