generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model WehowareClient {
  id                   String                           @id @default(uuid()) @db.VarChar(36)
  companyName          String                           @map("company_name") @db.VarChar(255)
  contactPerson        String?                          @map("contact_person") @db.VarChar(255)
  contactNumber        String?                          @map("contact_number") @db.VarChar(50)
  email                String?                          @db.VarChar(255)
  address              String?                          @db.Text
  website              String?                          @db.VarChar(500)
  industry             String?                          @db.VarChar(100)
  domain               String?                          @db.VarChar(255)
  active               Boolean                          @default(true)
  createdAt            DateTime                         @default(now()) @map("created_at")
  updatedAt            DateTime                         @updatedAt @map("updated_at")
  publicSlug           String?                          @unique @map("public_slug") @db.VarChar(255)
  accountingSettings   WehowareAccountingSettings?
  appointmentTypes     WehowareAppointmentType[]
  appointments         WehowareAppointment[]
  bankAccounts         WehowareBankAccount[]
  bankStatementEntries WehowareBankStatementEntry[]
  billLineItems        WehowareBillLineItem[]
  billPayments         WehowareBillPayment[]
  bills                WehowareBill[]
  blogCategories       WehowareBlogCategory[]
  blogs                WehowareBlog[]
  blogFaqs             WehowareBlogFaq[]
  serviceFaqs            WehowareServiceFaq[]
  keywords             WehowareClientKeyword[]
  switchHistory        WehowareClientSwitchHistory[]
  emailLogs            WehowareEmailLog[]
  expenses             WehowareExpense[]
  formFields           WehowareFormField[]
  formSubmissions      WehowareFormSubmission[]
  formTemplates        WehowareFormTemplate[]
  inquiries            WehowareInquiry[]
  integrationLogs      WehowareIntegrationLog[]
  integrationWebhooks  WehowareIntegrationWebhook[]
  integrations         WehowareIntegration[]
  calendarEvents       WehowareCalendarEvent[]
  invoiceLineItems     WehowareInvoiceLineItem[]
  invoiceSettings      WehowareInvoiceSettings?
  invoices             WehowareInvoice[]
  notifPrefs           WehowareNotificationPreference[]
  plaidItems           WehowarePlaidItem[]
  profiles             WehowareProfile[]
  reminderRules        WehowareReminderRule[]
  reportShares         WehowareReportShare[]
  reportTemplates      WehowareReportTemplate[]
  reports              WehowareReport[]
  serviceCategories    WehowareServiceCategory[]
  services             WehowareService[]
  settings             WehowareSetting[]
  staticPages          WehowareStaticPage[]
  tasks                WehowareTask[]
  transactions         WehowareTransaction[]
  userClients          WehowareUserClient[]
  invites              WehowareUserInvite[]
  vendors              WehowareVendor[]
  customers            WehowareCustomer[]
  goals                WehowareGoal[]
  achievements         WehowareAchievement[]
  socialAccounts       WehowareSocialAccount[]
  socialPosts          WehowareSocialPost[]
  inboxConversations   WehowareSocialInboxConversation[]
  dailyWorkReports     WehowareDailyWorkReport[]
  inventoryCategories  WehowareInventoryCategory[]
  inventoryItems       WehowareInventoryItem[]
  inventorySettings    WehowareInventorySetting?
  inventoryStockMovements WehowareInventoryStockMovement[]

  @@map("wehoware_clients")
}

model WehowareProfile {
  id                       String                        @id @default(uuid()) @db.VarChar(36)
  email                    String                        @unique @db.VarChar(255)
  passwordHash             String?                       @map("password_hash") @db.VarChar(255)
  firstName                String?                       @map("first_name") @db.VarChar(100)
  lastName                 String?                       @map("last_name") @db.VarChar(100)
  avatarUrl                String?                       @map("avatar_url") @db.VarChar(500)
  role                     UserRole                      @default(client)
  clientId                 String?                       @map("client_id") @db.VarChar(36)
  settings                 Json?                         @db.Json
  lastReminderSentAt       DateTime?                     @map("last_reminder_sent_at")
  createdAt                DateTime                      @default(now()) @map("created_at")
  updatedAt                DateTime                      @updatedAt @map("updated_at")
  createdAppointmentTypes  WehowareAppointmentType[]     @relation("AppointmentTypeCreator")
  createdAppointments      WehowareAppointment[]         @relation("AppointmentCreator")
  updatedAppointments      WehowareAppointment[]         @relation("AppointmentUpdater")
  createdBankAccounts      WehowareBankAccount[]         @relation("BankAccountCreator")
  createdBillPayments      WehowareBillPayment[]         @relation("BillPaymentCreator")
  createdBills             WehowareBill[]                @relation("BillCreator")
  updatedBills             WehowareBill[]                @relation("BillUpdater")
  createdBlogCategories    WehowareBlogCategory[]        @relation("BlogCategoryCreator")
  updatedBlogCategories    WehowareBlogCategory[]        @relation("BlogCategoryUpdater")
  createdBlogs             WehowareBlog[]                @relation("BlogCreator")
  updatedBlogs             WehowareBlog[]                @relation("BlogUpdater")
  keywords                 WehowareClientKeyword[]
  switchHistory            WehowareClientSwitchHistory[]
  approvedExpenses         WehowareExpense[]             @relation("ExpenseApprover")
  submittedExpenses        WehowareExpense[]             @relation("ExpenseSubmitter")
  updatedFormSubmissions   WehowareFormSubmission[]      @relation("FormSubmissionUpdater")
  createdFormTemplates     WehowareFormTemplate[]        @relation("FormTemplateCreator")
  updatedFormTemplates     WehowareFormTemplate[]        @relation("FormTemplateUpdater")
  updatedInquiries         WehowareInquiry[]             @relation("InquiryUpdater")
  createdIntegrations      WehowareIntegration[]         @relation("IntegrationCreator")
  updatedIntegrations      WehowareIntegration[]         @relation("IntegrationUpdater")
  createdInvoices          WehowareInvoice[]             @relation("InvoiceCreator")
  updatedInvoices          WehowareInvoice[]             @relation("InvoiceUpdater")
  createdPlaidItems        WehowarePlaidItem[]           @relation("PlaidItemCreator")
  client                   WehowareClient?               @relation(fields: [clientId], references: [id])
  createdReminderRules     WehowareReminderRule[]        @relation("ReminderRuleCreator")
  createdReportShares      WehowareReportShare[]         @relation("ReportShareCreator")
  createdReportTemplates   WehowareReportTemplate[]      @relation("ReportTemplateCreator")
  updatedReportTemplates   WehowareReportTemplate[]      @relation("ReportTemplateUpdater")
  createdReports           WehowareReport[]              @relation("ReportCreator")
  updatedReports           WehowareReport[]              @relation("ReportUpdater")
  createdServiceCategories WehowareServiceCategory[]     @relation("ServiceCategoryCreator")
  updatedServiceCategories WehowareServiceCategory[]     @relation("ServiceCategoryUpdater")
  createdServices          WehowareService[]             @relation("ServiceCreator")
  updatedServices          WehowareService[]             @relation("ServiceUpdater")
  taskActivities           WehowareTaskActivity[]
  taskComments             WehowareTaskComment[]
  assignedTasks            WehowareTask[]                @relation("TaskAssignee")
  createdTasks             WehowareTask[]                @relation("TaskCreator")
  createdTransactions      WehowareTransaction[]         @relation("TransactionCreator")
  userClients              WehowareUserClient[]
  createdVendors           WehowareVendor[]              @relation("VendorCreator")
  updatedVendors           WehowareVendor[]              @relation("VendorUpdater")
  createdCustomers         WehowareCustomer[]            @relation("CustomerCreator")
  updatedCustomers         WehowareCustomer[]            @relation("CustomerUpdater")
  invitedInvites           WehowareUserInvite[]        @relation("InviteCreator")
  achievements             WehowareAchievement[]       @relation("UserAchievements")
  ownedGoals               WehowareGoal[]              @relation("GoalOwner")
  createdGoals             WehowareGoal[]              @relation("GoalCreator")
  assignedSubtasks         WehowareSubtask[]           @relation("SubtaskAssignee")
  createdSubtasks          WehowareSubtask[]           @relation("SubtaskCreator")
  timeEntries              WehowareTaskTimeEntry[]
  createdSocialAccounts    WehowareSocialAccount[]     @relation("SocialAccountCreator")
  updatedSocialAccounts    WehowareSocialAccount[]     @relation("SocialAccountUpdater")
  createdSocialPosts       WehowareSocialPost[]        @relation("SocialPostCreator")
  updatedSocialPosts       WehowareSocialPost[]        @relation("SocialPostUpdater")
  savedBlogVersions        WehowareBlogVersion[]       @relation("BlogVersionSaver")
  savedServiceVersions     WehowareServiceVersion[]    @relation("ServiceVersionSaver")
  dailyWorkReports         WehowareDailyWorkReport[]
  createdInventoryCategories WehowareInventoryCategory[] @relation("InventoryCategoryCreator")
  updatedInventoryCategories WehowareInventoryCategory[] @relation("InventoryCategoryUpdater")
  createdInventoryItems      WehowareInventoryItem[]    @relation("InventoryItemCreator")
  updatedInventoryItems      WehowareInventoryItem[]    @relation("InventoryItemUpdater")
  inventoryStockMovements    WehowareInventoryStockMovement[]

  @@index([role])
  @@index([clientId])
  @@map("wehoware_profiles")
}

model WehowareBlogCategory {
  id          String           @id @default(uuid()) @db.VarChar(36)
  clientId    String           @map("client_id") @db.VarChar(36)
  name        String           @db.VarChar(255)
  slug        String           @unique @db.VarChar(255)
  description String?          @db.Text
  iconUrl     String?          @map("icon_url") @db.VarChar(500)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  createdBy   String?          @map("created_by") @db.VarChar(36)
  updatedBy   String?          @map("updated_by") @db.VarChar(36)
  client      WehowareClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator     WehowareProfile? @relation("BlogCategoryCreator", fields: [createdBy], references: [id])
  updater     WehowareProfile? @relation("BlogCategoryUpdater", fields: [updatedBy], references: [id])
  blogs       WehowareBlog[]

  @@index([clientId], map: "wehoware_blog_categories_client_id_fkey")
  @@index([createdBy], map: "wehoware_blog_categories_created_by_fkey")
  @@index([updatedBy], map: "wehoware_blog_categories_updated_by_fkey")
  @@map("wehoware_blog_categories")
}

model WehowareBlog {
  id                  String                      @id @default(uuid()) @db.VarChar(36)
  clientId            String                      @map("client_id") @db.VarChar(36)
  title               String                      @db.VarChar(500)
  slug                String                      @db.VarChar(500)
  excerpt             String?                     @db.Text
  content             String?                     @db.LongText
  thumbnail           String?                     @db.VarChar(500)
  thumbnailAlt        String?                     @map("thumbnail_alt") @db.VarChar(255)
  status              BlogStatus                  @default(Draft)
  categoryId          String?                     @map("category_id") @db.VarChar(36)
  featured            Boolean                     @default(false)
  readTime            Int?                        @map("read_time")
  views               Int                         @default(0)
  likes               Int                         @default(0)
  tags                Json
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")
  publishedAt         DateTime?                   @map("published_at")
  scheduledPublishAt  DateTime?                   @map("scheduled_publish_at")
  createdBy           String?                     @map("created_by") @db.VarChar(36)
  updatedBy           String?                     @map("updated_by") @db.VarChar(36)
  metaTitle           String?                     @map("meta_title") @db.VarChar(255)
  metaDescription     String?                     @map("meta_description") @db.VarChar(500)
  metaKeywords        String?                     @map("meta_keywords") @db.VarChar(500)
  openGraphTitle      String?                     @map("open_graph_title") @db.VarChar(255)
  openGraphDescription String?                    @map("open_graph_description") @db.VarChar(500)
  openGraphImage      String?                     @map("open_graph_image") @db.VarChar(500)
  twitterTitle        String?                     @map("twitter_title") @db.VarChar(255)
  twitterDescription  String?                     @map("twitter_description") @db.VarChar(500)
  twitterImage        String?                     @map("twitter_image") @db.VarChar(500)
  canonicalUrl        String?                     @map("canonical_url") @db.VarChar(500)
  robotsMeta          String                      @default("index,follow") @map("robots_meta") @db.VarChar(50)
  schemaType          String                      @default("BlogPosting") @map("schema_type") @db.VarChar(100)
  seoScore            Int                         @default(0) @map("seo_score")
  targetKeywords      Json?                       @map("target_keywords")
  showToc             Boolean                     @default(false) @map("show_toc")
  showAuthorBox       Boolean                     @default(true) @map("show_author_box")
  ctaHeading          String?                     @map("cta_heading") @db.VarChar(255)
  ctaBody             String?                     @map("cta_body") @db.Text
  ctaButtonText       String?                     @map("cta_button_text") @db.VarChar(100)
  ctaButtonUrl        String?                     @map("cta_button_url") @db.VarChar(500)
  allowSocialShare    Boolean                     @default(true) @map("allow_social_share")
  category            WehowareBlogCategory?       @relation(fields: [categoryId], references: [id])
  client              WehowareClient              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator             WehowareProfile?            @relation("BlogCreator", fields: [createdBy], references: [id])
  updater             WehowareProfile?            @relation("BlogUpdater", fields: [updatedBy], references: [id])
  versions            WehowareBlogVersion[]
  relatedServices     WehowareBlogServiceRelation[]
  faqs                WehowareBlogFaq[]

  @@unique([clientId, slug])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@index([scheduledPublishAt])
  @@index([clientId], map: "wehoware_blogs_client_id_fkey")
  @@index([createdBy], map: "wehoware_blogs_created_by_fkey")
  @@index([updatedBy], map: "wehoware_blogs_updated_by_fkey")
  @@map("wehoware_blogs")
}

model WehowareServiceCategory {
  id          String            @id @default(uuid()) @db.VarChar(36)
  clientId    String            @map("client_id") @db.VarChar(36)
  name        String            @db.VarChar(255)
  slug        String            @unique @db.VarChar(255)
  description String?           @db.Text
  iconUrl     String?           @map("icon_url") @db.VarChar(500)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  createdBy   String?           @map("created_by") @db.VarChar(36)
  updatedBy   String?           @map("updated_by") @db.VarChar(36)
  client      WehowareClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator     WehowareProfile?  @relation("ServiceCategoryCreator", fields: [createdBy], references: [id])
  updater     WehowareProfile?  @relation("ServiceCategoryUpdater", fields: [updatedBy], references: [id])
  services    WehowareService[]

  @@index([clientId], map: "wehoware_service_categories_client_id_fkey")
  @@index([createdBy], map: "wehoware_service_categories_created_by_fkey")
  @@index([updatedBy], map: "wehoware_service_categories_updated_by_fkey")
  @@map("wehoware_service_categories")
}

model WehowareService {
  id                 String                      @id @default(uuid()) @db.VarChar(36)
  clientId           String                      @map("client_id") @db.VarChar(36)
  title              String                      @db.VarChar(500)
  slug               String                      @db.VarChar(500)
  description        String?                     @db.Text
  content            String?                     @db.LongText
  thumbnail          String?                     @db.VarChar(500)
  thumbnailAlt       String?                     @map("thumbnail_alt") @db.VarChar(255)
  active             Boolean                     @default(true)
  categoryId         String?                     @map("category_id") @db.VarChar(36)
  fee                Decimal?                    @db.Decimal(10, 2)
  feeCurrency        String                      @default("CAD") @map("fee_currency") @db.VarChar(10)
  serviceCode        String?                     @map("service_code") @db.VarChar(100)
  featured           Boolean                     @default(false)
  rating             Decimal                     @default(0.00) @db.Decimal(3, 2)
  reviewsCount       Int                         @default(0) @map("reviews_count")
  tags               Json
  duration           String?                     @db.VarChar(100)
  scheduledPublishAt DateTime?                   @map("scheduled_publish_at")
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  createdBy          String?                     @map("created_by") @db.VarChar(36)
  updatedBy          String?                     @map("updated_by") @db.VarChar(36)
  metaTitle          String?                     @map("meta_title") @db.VarChar(255)
  metaDescription    String?                     @map("meta_description") @db.VarChar(500)
  metaKeywords       String?                     @map("meta_keywords") @db.VarChar(500)
  openGraphTitle     String?                     @map("open_graph_title") @db.VarChar(255)
  openGraphDescription String?                   @map("open_graph_description") @db.VarChar(500)
  openGraphImage     String?                     @map("open_graph_image") @db.VarChar(500)
  twitterTitle       String?                     @map("twitter_title") @db.VarChar(255)
  twitterDescription String?                     @map("twitter_description") @db.VarChar(500)
  twitterImage       String?                     @map("twitter_image") @db.VarChar(500)
  canonicalUrl       String?                     @map("canonical_url") @db.VarChar(500)
  robotsMeta         String                      @default("index,follow") @map("robots_meta") @db.VarChar(50)
  schemaType         String                      @default("Service") @map("schema_type") @db.VarChar(100)
  seoScore           Int                         @default(0) @map("seo_score")
  targetKeywords     Json?                       @map("target_keywords")
  ctaHeading         String?                     @map("cta_heading") @db.VarChar(255)
  ctaBody            String?                     @map("cta_body") @db.Text
  ctaButtonText      String?                     @map("cta_button_text") @db.VarChar(100)
  ctaButtonUrl       String?                     @map("cta_button_url") @db.VarChar(500)
  allowSocialShare   Boolean                     @default(true) @map("allow_social_share")
  views              Int                         @default(0)
  inquiries          WehowareInquiry[]
  versions           WehowareServiceVersion[]
  relatedBlogs       WehowareBlogServiceRelation[]
  faqs               WehowareServiceFaq[]
  category           WehowareServiceCategory?    @relation(fields: [categoryId], references: [id])
  client             WehowareClient              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator            WehowareProfile?            @relation("ServiceCreator", fields: [createdBy], references: [id])
  updater            WehowareProfile?            @relation("ServiceUpdater", fields: [updatedBy], references: [id])

  @@unique([clientId, slug])
  @@index([categoryId])
  @@index([active])
  @@index([scheduledPublishAt])
  @@index([clientId], map: "wehoware_services_client_id_fkey")
  @@index([createdBy], map: "wehoware_services_created_by_fkey")
  @@index([updatedBy], map: "wehoware_services_updated_by_fkey")
  @@map("wehoware_services")
}

model WehowareInquiry {
  id        String           @id @default(uuid()) @db.VarChar(36)
  clientId  String           @map("client_id") @db.VarChar(36)
  name      String           @db.VarChar(255)
  email     String           @db.VarChar(255)
  phone     String?          @db.VarChar(50)
  subject   String           @db.VarChar(500)
  message   String           @db.Text
  serviceId String?          @map("service_id") @db.VarChar(36)
  status    InquiryStatus    @default(New)
  ipAddress String?          @map("ip_address") @db.VarChar(45)
  userAgent String?          @map("user_agent") @db.VarChar(500)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  updatedBy String?          @map("updated_by") @db.VarChar(36)
  client    WehowareClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service   WehowareService? @relation(fields: [serviceId], references: [id])
  updater   WehowareProfile? @relation("InquiryUpdater", fields: [updatedBy], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([clientId], map: "wehoware_inquiries_client_id_fkey")
  @@index([serviceId], map: "wehoware_inquiries_service_id_fkey")
  @@index([updatedBy], map: "wehoware_inquiries_updated_by_fkey")
  @@map("wehoware_inquiries")
}

model WehowareStaticPage {
  id                   String         @id @default(uuid()) @db.VarChar(36)
  clientId             String         @map("client_id") @db.VarChar(36)
  pageSlug             String         @map("page_slug") @db.VarChar(255)
  title                String?        @db.VarChar(500)
  content              String?        @db.LongText
  templateName         String?        @map("template_name") @db.VarChar(255)
  layout               Json?
  metaTitle            String?        @map("meta_title") @db.VarChar(255)
  metaDescription      String?        @map("meta_description") @db.VarChar(500)
  metaKeywords         String?        @map("meta_keywords") @db.VarChar(500)
  openGraphTitle       String?        @map("open_graph_title") @db.VarChar(255)
  openGraphDescription String?        @map("open_graph_description") @db.VarChar(500)
  openGraphImage       String?        @map("open_graph_image") @db.VarChar(500)
  isActive             Boolean        @default(true) @map("is_active")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  client               WehowareClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId], map: "wehoware_static_pages_client_id_fkey")
  @@map("wehoware_static_pages")
}

model WehowareSetting {
  id           String         @id @default(uuid()) @db.VarChar(36)
  clientId     String         @map("client_id") @db.VarChar(36)
  settingKey   String         @map("setting_key") @db.VarChar(255)
  settingValue String?        @map("setting_value") @db.Text
  settingGroup String?        @map("setting_group") @db.VarChar(100)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  client       WehowareClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, settingKey])
  @@index([clientId])
  @@index([settingKey])
  @@map("wehoware_settings")
}

model WehowareNotificationPreference {
  id            String         @id @default(uuid()) @db.VarChar(36)
  clientId      String         @map("client_id") @db.VarChar(36)
  preferenceKey String         @map("preference_key") @db.VarChar(255)
  description   String?        @db.Text
  enabled       Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  client        WehowareClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId], map: "wehoware_notification_preferences_client_id_fkey")
  @@map("wehoware_notification_preferences")
}

model WehowareFormTemplate {
  id                 String                   @id @default(uuid()) @db.VarChar(36)
  clientId           String                   @map("client_id") @db.VarChar(36)
  title              String                   @db.VarChar(500)
  description        String?                  @db.Text
  status             FormTemplateStatus       @default(Draft)
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  createdBy          String?                  @map("created_by") @db.VarChar(36)
  updatedBy          String?                  @map("updated_by") @db.VarChar(36)
  successMessage     String?                  @default("Thank you for your submission!") @map("success_message") @db.VarChar(500)
  redirectUrl        String?                  @map("redirect_url") @db.VarChar(500)
  notificationEmails Json                     @map("notification_emails")
  fields             WehowareFormField[]
  submissions        WehowareFormSubmission[]
  client             WehowareClient           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator            WehowareProfile?         @relation("FormTemplateCreator", fields: [createdBy], references: [id])
  updater            WehowareProfile?         @relation("FormTemplateUpdater", fields: [updatedBy], references: [id])

  @@index([clientId], map: "wehoware_form_templates_client_id_fkey")
  @@index([createdBy], map: "wehoware_form_templates_created_by_fkey")
  @@index([updatedBy], map: "wehoware_form_templates_updated_by_fkey")
  @@map("wehoware_form_templates")
}

model WehowareFormField {
  id              String               @id @default(uuid()) @db.VarChar(36)
  clientId        String               @map("client_id") @db.VarChar(36)
  formTemplateId  String               @map("form_template_id") @db.VarChar(36)
  fieldType       FormFieldType        @map("field_type")
  label           String               @db.VarChar(255)
  placeholder     String?              @db.VarChar(255)
  helpText        String?              @map("help_text") @db.VarChar(500)
  required        Boolean              @default(false)
  fieldOrder      Int                  @map("field_order")
  defaultValue    String?              @map("default_value") @db.VarChar(500)
  options         Json
  validationRules Json                 @map("validation_rules")
  cssClass        String?              @map("css_class") @db.VarChar(255)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  client          WehowareClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  formTemplate    WehowareFormTemplate @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)

