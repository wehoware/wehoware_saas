  dateRangeEnd      DateTime?    @map("date_range_end") @db.Date
  status            ReportStatus @default(Draft)
  isScheduled       Boolean      @default(false) @map("is_scheduled")
  scheduleFrequency String?      @map("schedule_frequency") @db.VarChar(100)
  lastGeneratedAt   DateTime?    @map("last_generated_at")
  nextGenerationAt  DateTime?    @map("next_generation_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  createdBy         String?      @map("created_by") @db.VarChar(36)
  updatedBy         String?      @map("updated_by") @db.VarChar(36)

