// =============================================================
model WehowareReportShare {
  id             String    @id @default(uuid()) @db.VarChar(36)
  clientId       String    @map("client_id") @db.VarChar(36)
  reportId       String    @map("report_id") @db.VarChar(36)
  accessToken    String    @map("access_token") @db.VarChar(255)
  recipientEmail String?   @map("recipient_email") @db.VarChar(255)
  recipientName  String?   @map("recipient_name") @db.VarChar(255)
  message        String?   @db.Text
  expiresAt      DateTime? @map("expires_at")
  lastAccessedAt DateTime? @map("last_accessed_at")
