# Node.js dependencies
node_modules/

docs/

# Next.js build output
.next/
out/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local environment variables (ensure these remain secure)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Mac system files
.DS_Store

# Coverage output (if running tests)
coverage/

# Optional: Vercel deployment configuration
.vercel/

# Optional: Storybook build output (if using Storybook)
storybook-static/

# Claude Code / agent workspace state (not code)
.claude/

# Local HTTPS certificates (mkcert)
certs/

# Dev TLS certs (mkcert) — never commit private keys
certificates/

# OAuth debug log (created at repo root by callback error logging)
oauth-errors.log
