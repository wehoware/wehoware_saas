  creator  WehowareProfile?       @relation("ReportCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater  WehowareProfile?       @relation("ReportUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
