# =============================================================================
# WeHowAre SaaS — Environment Variables
# =============================================================================
# Copy this file to .env.local (development) or set these in your hosting
# platform (AWS Amplify, Vercel, etc.) for production.
# =============================================================================

# --- Core Application ---
# MySQL connection string (RDS Aurora Serverless or any MySQL 8.0+)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://user:password@cluster.cluster-xxx.region.rds.amazonaws.com:3306/wehoware"

# NextAuth v5 — JWT signing secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=""
# NextAuth v5 — app URL (used for callbacks, cookies, etc.)
NEXTAUTH_URL="https://your-domain.com"

# Public app URL (used for OAuth callbacks, email links, etc.)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Default client UUID for public API routes (set after seeding)
NEXT_PUBLIC_CLIENT_ID=""

# --- Security ---
# Encryption key for sensitive data (API keys, OAuth tokens) — openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# Cron job authentication
CRON_SECRET=""
CRON_AUTH_MODE="hmac"

# --- AWS S3 (File Storage) ---
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""
AWS_S3_CDN_URL=""

# --- AWS SES (Email) ---
EMAIL_PROVIDER_MODE="ses"
EMAIL_FROM_ADDRESS="noreply@your-domain.com"

# --- Social Media Platforms ---
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_CALLBACK_URL="https://your-domain.com/api/v1/social/platforms/facebook/callback"
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_CALLBACK_URL="https://your-domain.com/api/v1/social/platforms/instagram/callback"
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_CALLBACK_URL="https://your-domain.com/api/v1/social/platforms/twitter/callback"
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_CALLBACK_URL="https://your-domain.com/api/v1/social/platforms/tiktok/callback"

# --- Calendar Integrations ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-domain.com/api/v1/integrations/google/calendar/callback"
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="https://your-domain.com/api/v1/integrations/microsoft/calendar/callback"

# --- Zoom Integration ---
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_REDIRECT_URI="https://your-domain.com/api/v1/integrations/zoom/callback"

# --- Plaid (Bank Account Sync) ---
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
PLAID_PRODUCTS="transactions"
PLAID_COUNTRY_CODES="US,CA"
PLAID_WEBHOOK_URL="https://your-domain.com/api/v1/plaid/webhook"

# --- SEO LLM Providers ---
SEO_LLM_PROVIDER_MODE="auto"
SEO_LLM_MANUAL_PROVIDER=""
SEO_LLM_AUTO_FAILOVER="true"
SEO_LLM_TIMEOUT_MS="30000"
SEO_LLM_CIRCUIT_BREAKER_THRESHOLD="5"
SEO_LLM_CIRCUIT_BREAKER_COOLDOWN_MS="60000"
OPENROUTER_DEFAULT_ANALYSIS_MODEL=""
OPENROUTER_DEFAULT_SUGGESTION_MODEL=""

# --- SEO Analyser Thresholds ---
SEO_ANALYSER_DUPLICATE_SIMILARITY_THRESHOLD="0.85"
SEO_ANALYSER_NEAR_DUPLICATE_THRESHOLD="0.70"
SEO_ANALYSER_FRESHNESS_STALE_MONTHS="6"
SEO_ANALYSER_TFIDF_LOW_THRESHOLD="0.01"

# --- Database Seeding (optional overrides) ---
SEED_ADMIN_EMAIL="admin@wehoware.com"
SEED_ADMIN_PASSWORD=""

# --- Baddy AI Assistant (vLLM integration) ---
VLLM_BASE_URL="http://localhost:18020/v1"
VLLM_API_KEY="wehoware-vllm-2026"
VLLM_MODEL="qwen3.8-27b"

# --- Mem0 Memory Bridge (persistent conversation memory) ---
MEM0_BRIDGE_URL="http://localhost:9097"
