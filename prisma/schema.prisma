// =============================================================
// Wehoware SaaS — Prisma Schema (MySQL 8.0+)
// Auth: NextAuth v5 JWT (stateless, no Session table required)
// UUID: generated by Prisma at app layer (@default(uuid()))
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================================
// ENUMS
// =============================================================

enum UserRole {
  client
  employee
  admin
}

enum BlogStatus {
  Draft
  Published
  Archived
}

enum InquiryStatus {
  New
  In_Progress @map("In Progress")
  Resolved
}

enum FormTemplateStatus {
  Draft
  Published
  Archived
}

enum FormSubmissionStatus {
  New
  Viewed
  Contacted
  Converted
  Archived
}

enum FormFieldType {
  text
  textarea
  email
  phone
  number
  date
  time
  checkbox
  radio
  select
  file
  hidden
}

enum IntegrationStatus {
  Active
  Paused
  Error
}

enum IntegrationLogStatus {
  Success
  Failed
  Partial
}

enum ReportStatus {
  Draft
  Published
  Archived
}

enum TaskPriority {
  Low
  Medium
  High
}

enum TaskStatus {
  To_Do       @map("To Do")
  In_Progress @map("In Progress")
  Done
  Backlog
}

enum AppointmentStatus {
  Pending
  Confirmed
  Cancelled
  Completed
  NoShow @map("No Show")
}

enum InvoiceStatus {
  Draft
  Pending
  Paid
  Overdue
  Cancelled
}

enum TransactionStatus {
  Pending
  Completed
  Failed
  Refunded
}

enum TransactionType {
  Subscription
  Service
  Refund
  Payout
  Sale
  Other
}

// =============================================================
// 1. Clients (Tenants)
// =============================================================
model WehowareClient {
  id            String   @id @default(uuid()) @db.VarChar(36)
  companyName   String   @map("company_name") @db.VarChar(255)
  contactPerson String?  @map("contact_person") @db.VarChar(255)
  contactNumber String?  @map("contact_number") @db.VarChar(50)
  email         String?  @db.VarChar(255)
  address       String?  @db.Text
  website       String?  @db.VarChar(500)
  industry      String?  @db.VarChar(100)
  domain        String?  @db.VarChar(255)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  profiles              WehowareProfile[]
  blogCategories        WehowareBlogCategory[]
  blogs                 WehowareBlog[]
  serviceCategories     WehowareServiceCategory[]
  services              WehowareService[]
  inquiries             WehowareInquiry[]
  staticPages           WehowareStaticPage[]
  settings              WehowareSetting[]
  notifPrefs            WehowareNotificationPreference[]
  formTemplates         WehowareFormTemplate[]
  formFields            WehowareFormField[]
  formSubmissions       WehowareFormSubmission[]
  integrations          WehowareIntegration[]
  integrationWebhooks   WehowareIntegrationWebhook[]
  integrationLogs       WehowareIntegrationLog[]
  reportTemplates       WehowareReportTemplate[]
  reports               WehowareReport[]
  reportShares          WehowareReportShare[]
  userClients           WehowareUserClient[]
  switchHistory         WehowareClientSwitchHistory[]
  keywords              WehowareClientKeyword[]
  tasks                 WehowareTask[]
  appointmentTypes      WehowareAppointmentType[]
  appointments          WehowareAppointment[]
  invoices              WehowareInvoice[]
  invoiceLineItems      WehowareInvoiceLineItem[]
  transactions          WehowareTransaction[]

  @@map("wehoware_clients")
}

// =============================================================
// 2. Profiles (Users — replaces Supabase auth.users)
//    email + passwordHash added for NextAuth Credentials auth
// =============================================================
model WehowareProfile {
  id           String   @id @default(uuid()) @db.VarChar(36)
  email        String   @unique @db.VarChar(255)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  firstName    String?  @map("first_name") @db.VarChar(100)
  lastName     String?  @map("last_name") @db.VarChar(100)
  avatarUrl    String?  @map("avatar_url") @db.VarChar(500)
  role         UserRole @default(client)
  clientId     String?  @map("client_id") @db.VarChar(36)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  client        WehowareClient?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  userClients   WehowareUserClient[]
  switchHistory WehowareClientSwitchHistory[]
  keywords      WehowareClientKeyword[]

  // Audit: creator/updater relations on other tables
  createdBlogCategories    WehowareBlogCategory[]    @relation("BlogCategoryCreator")
  updatedBlogCategories    WehowareBlogCategory[]    @relation("BlogCategoryUpdater")
  createdBlogs             WehowareBlog[]            @relation("BlogCreator")
  updatedBlogs             WehowareBlog[]            @relation("BlogUpdater")
  createdServiceCategories WehowareServiceCategory[] @relation("ServiceCategoryCreator")
  updatedServiceCategories WehowareServiceCategory[] @relation("ServiceCategoryUpdater")
  createdServices          WehowareService[]         @relation("ServiceCreator")
  updatedServices          WehowareService[]         @relation("ServiceUpdater")
  updatedInquiries         WehowareInquiry[]         @relation("InquiryUpdater")
  createdFormTemplates     WehowareFormTemplate[]    @relation("FormTemplateCreator")
  updatedFormTemplates     WehowareFormTemplate[]    @relation("FormTemplateUpdater")
  updatedFormSubmissions   WehowareFormSubmission[]  @relation("FormSubmissionUpdater")
  createdIntegrations      WehowareIntegration[]     @relation("IntegrationCreator")
  updatedIntegrations      WehowareIntegration[]     @relation("IntegrationUpdater")
  createdReportTemplates   WehowareReportTemplate[]  @relation("ReportTemplateCreator")
  updatedReportTemplates   WehowareReportTemplate[]  @relation("ReportTemplateUpdater")
  createdReports           WehowareReport[]          @relation("ReportCreator")
  updatedReports           WehowareReport[]          @relation("ReportUpdater")
  createdReportShares      WehowareReportShare[]     @relation("ReportShareCreator")
  createdTasks             WehowareTask[]            @relation("TaskCreator")
  assignedTasks            WehowareTask[]            @relation("TaskAssignee")
  taskActivities           WehowareTaskActivity[]
  taskComments             WehowareTaskComment[]
  createdAppointmentTypes  WehowareAppointmentType[] @relation("AppointmentTypeCreator")
  createdAppointments      WehowareAppointment[]     @relation("AppointmentCreator")
  updatedAppointments      WehowareAppointment[]     @relation("AppointmentUpdater")
  createdInvoices          WehowareInvoice[]         @relation("InvoiceCreator")
  updatedInvoices          WehowareInvoice[]         @relation("InvoiceUpdater")
  createdTransactions      WehowareTransaction[]     @relation("TransactionCreator")

  @@index([role])
  @@index([clientId])
  @@map("wehoware_profiles")
}

// =============================================================
// 3. Blog Categories
// =============================================================
model WehowareBlogCategory {
  id          String   @id @default(uuid()) @db.VarChar(36)
  clientId    String   @map("client_id") @db.VarChar(36)
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?  @db.Text
  iconUrl     String?  @map("icon_url") @db.VarChar(500)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by") @db.VarChar(36)
  updatedBy   String?  @map("updated_by") @db.VarChar(36)

  client    WehowareClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator   WehowareProfile? @relation("BlogCategoryCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater   WehowareProfile? @relation("BlogCategoryUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  blogs     WehowareBlog[]

  @@map("wehoware_blog_categories")
}

// =============================================================
// 4. Blogs
// =============================================================
model WehowareBlog {
  id              String     @id @default(uuid()) @db.VarChar(36)
  clientId        String     @map("client_id") @db.VarChar(36)
  title           String     @db.VarChar(500)
  slug            String     @unique @db.VarChar(500)
  excerpt         String?    @db.Text
  content         String?    @db.LongText
  thumbnail       String?    @db.VarChar(500)
  status          BlogStatus @default(Draft)
  categoryId      String?    @map("category_id") @db.VarChar(36)
  featured        Boolean    @default(false)
  readTime        Int?       @map("read_time")
  views           Int        @default(0)
  likes           Int        @default(0)
  tags            Json       @default("[]")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  publishedAt     DateTime?  @map("published_at")
  createdBy       String?    @map("created_by") @db.VarChar(36)
  updatedBy       String?    @map("updated_by") @db.VarChar(36)
  metaTitle       String?    @map("meta_title") @db.VarChar(255)
  metaDescription String?    @map("meta_description") @db.VarChar(500)
  metaKeywords    String?    @map("meta_keywords") @db.VarChar(500)

  client   WehowareClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category WehowareBlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creator  WehowareProfile?     @relation("BlogCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater  WehowareProfile?     @relation("BlogUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@map("wehoware_blogs")
}

// =============================================================
// 5. Service Categories
// =============================================================
model WehowareServiceCategory {
  id          String   @id @default(uuid()) @db.VarChar(36)
  clientId    String   @map("client_id") @db.VarChar(36)
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?  @db.Text
  iconUrl     String?  @map("icon_url") @db.VarChar(500)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by") @db.VarChar(36)
  updatedBy   String?  @map("updated_by") @db.VarChar(36)

  client   WehowareClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator  WehowareProfile? @relation("ServiceCategoryCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater  WehowareProfile? @relation("ServiceCategoryUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  services WehowareService[]

  @@map("wehoware_service_categories")
}

// =============================================================
// 6. Services
// =============================================================
model WehowareService {
  id              String   @id @default(uuid()) @db.VarChar(36)
  clientId        String   @map("client_id") @db.VarChar(36)
  title           String   @db.VarChar(500)
  slug            String   @unique @db.VarChar(500)
  description     String?  @db.Text
  content         String?  @db.LongText
  thumbnail       String?  @db.VarChar(500)
  active          Boolean  @default(true)
  categoryId      String?  @map("category_id") @db.VarChar(36)
  fee             Decimal? @db.Decimal(10, 2)
  feeCurrency     String   @default("CAD") @map("fee_currency") @db.VarChar(10)
  serviceCode     String?  @map("service_code") @db.VarChar(100)
  featured        Boolean  @default(false)
  rating          Decimal  @default(0) @db.Decimal(3, 2)
  reviewsCount    Int      @default(0) @map("reviews_count")
  tags            Json     @default("[]")
  duration        Int?
  views           Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.VarChar(36)
  updatedBy       String?  @map("updated_by") @db.VarChar(36)
  metaTitle       String?  @map("meta_title") @db.VarChar(255)
  metaDescription String?  @map("meta_description") @db.VarChar(500)
  metaKeywords    String?  @map("meta_keywords") @db.VarChar(500)

  client    WehowareClient          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category  WehowareServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creator   WehowareProfile?        @relation("ServiceCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater   WehowareProfile?        @relation("ServiceUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  inquiries WehowareInquiry[]

  @@index([categoryId])
  @@index([active])
  @@map("wehoware_services")
}

// =============================================================
// 7. Inquiries
// =============================================================
model WehowareInquiry {
  id        String        @id @default(uuid()) @db.VarChar(36)
  clientId  String        @map("client_id") @db.VarChar(36)
  name      String        @db.VarChar(255)
  email     String        @db.VarChar(255)
  phone     String?       @db.VarChar(50)
  subject   String        @db.VarChar(500)
  message   String        @db.Text
  serviceId String?       @map("service_id") @db.VarChar(36)
  status    InquiryStatus @default(New)
  ipAddress String?       @map("ip_address") @db.VarChar(45)
  userAgent String?       @map("user_agent") @db.VarChar(500)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  updatedBy String?       @map("updated_by") @db.VarChar(36)

  client  WehowareClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service WehowareService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  updater WehowareProfile? @relation("InquiryUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@map("wehoware_inquiries")
}

// =============================================================
// 8. Static Pages
// =============================================================
model WehowareStaticPage {
  id                   String   @id @default(uuid()) @db.VarChar(36)
  clientId             String   @map("client_id") @db.VarChar(36)
  pageSlug             String   @map("page_slug") @db.VarChar(255)
  title                String?  @db.VarChar(500)
  content              String?  @db.LongText
  templateName         String?  @map("template_name") @db.VarChar(255)
  layout               Json?
  metaTitle            String?  @map("meta_title") @db.VarChar(255)
  metaDescription      String?  @map("meta_description") @db.VarChar(500)
  metaKeywords         String?  @map("meta_keywords") @db.VarChar(500)
  openGraphTitle       String?  @map("open_graph_title") @db.VarChar(255)
  openGraphDescription String?  @map("open_graph_description") @db.VarChar(500)
  openGraphImage       String?  @map("open_graph_image") @db.VarChar(500)
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  client WehowareClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("wehoware_static_pages")
}

// =============================================================
// 9. Settings
// =============================================================
model WehowareSetting {
  id           String   @id @default(uuid()) @db.VarChar(36)
  clientId     String   @map("client_id") @db.VarChar(36)
  settingKey   String   @map("setting_key") @db.VarChar(255)
  settingValue String?  @map("setting_value") @db.Text
  settingGroup String?  @map("setting_group") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  client WehowareClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, settingKey])
  @@index([clientId])
  @@index([settingKey])
  @@map("wehoware_settings")
}

// =============================================================
// 10. Notification Preferences
// =============================================================
model WehowareNotificationPreference {
  id            String   @id @default(uuid()) @db.VarChar(36)
  clientId      String   @map("client_id") @db.VarChar(36)
  preferenceKey String   @map("preference_key") @db.VarChar(255)
  description   String?  @db.Text
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  client WehowareClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("wehoware_notification_preferences")
}

// =============================================================
// 11. Form Templates
// =============================================================
model WehowareFormTemplate {
  id                 String             @id @default(uuid()) @db.VarChar(36)
  clientId           String             @map("client_id") @db.VarChar(36)
  title              String             @db.VarChar(500)
  description        String?            @db.Text
  status             FormTemplateStatus @default(Draft)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  createdBy          String?            @map("created_by") @db.VarChar(36)
  updatedBy          String?            @map("updated_by") @db.VarChar(36)
  successMessage     String?            @default("Thank you for your submission!") @map("success_message") @db.VarChar(500)
  redirectUrl        String?            @map("redirect_url") @db.VarChar(500)
  notificationEmails Json               @default("[]") @map("notification_emails")

  client      WehowareClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator     WehowareProfile?     @relation("FormTemplateCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater     WehowareProfile?     @relation("FormTemplateUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  fields      WehowareFormField[]
  submissions WehowareFormSubmission[]

  @@map("wehoware_form_templates")
}

// =============================================================
// 12. Form Fields
// =============================================================
model WehowareFormField {
  id              String        @id @default(uuid()) @db.VarChar(36)
  clientId        String        @map("client_id") @db.VarChar(36)
  formTemplateId  String        @map("form_template_id") @db.VarChar(36)
  fieldType       FormFieldType @map("field_type")
  label           String        @db.VarChar(255)
  placeholder     String?       @db.VarChar(255)
  helpText        String?       @map("help_text") @db.VarChar(500)
  required        Boolean       @default(false)
  fieldOrder      Int           @map("field_order")
  defaultValue    String?       @map("default_value") @db.VarChar(500)
  options         Json          @default("[]")
  validationRules Json          @default("{}") @map("validation_rules")
  cssClass        String?       @map("css_class") @db.VarChar(255)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  client       WehowareClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  formTemplate WehowareFormTemplate @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)

  @@map("wehoware_form_fields")
}

// =============================================================
// 13. Form Submissions
// =============================================================
model WehowareFormSubmission {
  id             String               @id @default(uuid()) @db.VarChar(36)
  clientId       String               @map("client_id") @db.VarChar(36)
  formTemplateId String               @map("form_template_id") @db.VarChar(36)
  submissionData Json                 @map("submission_data")
  submittedAt    DateTime             @default(now()) @map("submitted_at")
  ipAddress      String?              @map("ip_address") @db.VarChar(45)
  userAgent      String?              @map("user_agent") @db.VarChar(500)
  status         FormSubmissionStatus @default(New)
  notes          String?              @db.Text
  tags           Json                 @default("[]")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  updatedBy      String?              @map("updated_by") @db.VarChar(36)

  client       WehowareClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  formTemplate WehowareFormTemplate @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)
  updater      WehowareProfile?     @relation("FormSubmissionUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("wehoware_form_submissions")
}

// =============================================================
// 14. Integration Providers
// =============================================================
model WehowareIntegrationProvider {
  id               String   @id @default(uuid()) @db.VarChar(36)
  name             String   @db.VarChar(255)
  category         String   @db.VarChar(100)
  description      String?  @db.Text
  logoUrl          String?  @map("logo_url") @db.VarChar(500)
  documentationUrl String?  @map("documentation_url") @db.VarChar(500)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  integrations WehowareIntegration[]

  @@map("wehoware_integration_providers")
}

// =============================================================
// 15. Integrations
// =============================================================
model WehowareIntegration {
  id             String            @id @default(uuid()) @db.VarChar(36)
  clientId       String            @map("client_id") @db.VarChar(36)
  providerId     String            @map("provider_id") @db.VarChar(36)
  name           String            @db.VarChar(255)
  apiKey         String?           @map("api_key") @db.VarChar(500)
  apiSecret      String?           @map("api_secret") @db.VarChar(500)
  accessToken    String?           @map("access_token") @db.Text
  refreshToken   String?           @map("refresh_token") @db.Text
  tokenExpiresAt DateTime?         @map("token_expires_at")
  config         Json              @default("{}")
  status         IntegrationStatus @default(Active)
  lastSyncAt     DateTime?         @map("last_sync_at")
  syncFrequency  String?           @map("sync_frequency") @db.VarChar(100)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  createdBy      String?           @map("created_by") @db.VarChar(36)
  updatedBy      String?           @map("updated_by") @db.VarChar(36)

  client   WehowareClient              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  provider WehowareIntegrationProvider @relation(fields: [providerId], references: [id])
  creator  WehowareProfile?            @relation("IntegrationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater  WehowareProfile?            @relation("IntegrationUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  webhooks WehowareIntegrationWebhook[]
  logs     WehowareIntegrationLog[]

  @@map("wehoware_integrations")
}

// =============================================================
// 16. Integration Webhooks
// =============================================================
model WehowareIntegrationWebhook {
  id            String   @id @default(uuid()) @db.VarChar(36)
  clientId      String   @map("client_id") @db.VarChar(36)
  integrationId String   @map("integration_id") @db.VarChar(36)
  eventType     String   @map("event_type") @db.VarChar(100)
  webhookUrl    String   @map("webhook_url") @db.VarChar(500)
  active        Boolean  @default(true)
  secretKey     String?  @map("secret_key") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  client      WehowareClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  integration WehowareIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("wehoware_integration_webhooks")
}

// =============================================================
// 17. Integration Logs
// =============================================================
model WehowareIntegrationLog {
  id               String               @id @default(uuid()) @db.VarChar(36)
  clientId         String               @map("client_id") @db.VarChar(36)
  integrationId    String               @map("integration_id") @db.VarChar(36)
  operation        String               @db.VarChar(255)
  status           IntegrationLogStatus
  details          Json?
  startTime        DateTime             @default(now()) @map("start_time")
  endTime          DateTime?            @map("end_time")
  recordsProcessed Int?                 @map("records_processed")
  errorMessage     String?              @map("error_message") @db.Text

  client      WehowareClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  integration WehowareIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("wehoware_integration_logs")
}

// =============================================================
// 18. Report Templates
// =============================================================
model WehowareReportTemplate {
  id               String   @id @default(uuid()) @db.VarChar(36)
  clientId         String   @map("client_id") @db.VarChar(36)
  title            String   @db.VarChar(500)
  description      String?  @db.Text
  reportType       String   @map("report_type") @db.VarChar(100)
  layout           Json?
  components       Json?
  isSystemTemplate Boolean  @default(false) @map("is_system_template")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        String?  @map("created_by") @db.VarChar(36)
  updatedBy        String?  @map("updated_by") @db.VarChar(36)

  client  WehowareClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator WehowareProfile? @relation("ReportTemplateCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater WehowareProfile? @relation("ReportTemplateUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  reports WehowareReport[]

  @@map("wehoware_report_templates")
}

// =============================================================
// 19. Reports
// =============================================================
model WehowareReport {
  id                String       @id @default(uuid()) @db.VarChar(36)
  clientId          String       @map("client_id") @db.VarChar(36)
  templateId        String       @map("template_id") @db.VarChar(36)
  title             String       @db.VarChar(500)
